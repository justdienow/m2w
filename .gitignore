# Ignore Visual Studio specific files
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.cache
*.log

# Ignore build and bin/obj directories
bin/
obj/
out/
TestResults/
app.publish/
*.vspscc
*.vssscc

# Ignore NuGet packages
*.nupkg
packages/
project.lock.json
package-lock.json
node_modules/

# Ignore JetBrains Rider / ReSharper files
.idea/
*.sln.iml

# Ignore macOS files
.DS_Store

# Ignore compiled DLLs and executables
*.exe
*.dll
*.pdb

# Ignore temporary files
*.tmp
*.bak

# Ignore user secrets
secrets.json
secrets/
.env
.env.*

# Ignore database and entity framework migrations
Migrations/

# Ignore logs
*.log
logs/

# Ignore coverage reports
coverage/
*.coverage
*.coveragexml

# Ignore Publish artifacts
publish/
*.deploy.cmd
*.deploy-readme.txt
*.pubxml
*.pubxml.user

# Ignore debug/release folders
Debug/
Release/

# Ignore Rider and VS Code settings
.vscode/
*.code-workspace
